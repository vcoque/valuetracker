{
  "name": "@valuetracker/api",
  "version": "0.0.0",
  "private": true,
  "description": "ValueTracker API -- NestJS on Fastify, Prisma over PostgreSQL",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start:prod": "node dist/main.js",
    "start:dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@node-rs/argon2": "2.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@valuetracker/contract": "*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "typescript": "6.0.3"
  }
}
