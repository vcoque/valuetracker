{
  "name": "@valuetracker/api",
  "version": "0.0.0",
  "private": true,
  "description": "ValueTracker API -- NestJS on Fastify, Prisma over PostgreSQL",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start:prod": "node dist/main.js",
    "start:dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
