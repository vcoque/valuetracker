// ValueTracker database schema.
//
// Table and column names are snake_case, matching ARCHITECTURE.md and the
// SPEC-*.md entity dictionaries exactly; the Prisma models above them are
// PascalCase/camelCase, matching TypeScript. Every mapping is explicit, so a
// column can be read straight out of a spec and found in the database under the
// same name.
//
// Prisma 7 removed `url` from the datasource block entirely. The CLI reads its
// connection string from ../prisma.config.ts, and the running client is given a
// driver adapter built from the validated config in src/shared/config -- which
// is exactly the separation SPEC.md §Boundaries asks for: application code never
// reaches into process.env for a connection string.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// ISO 4217 reference data. Seeded, never user-editable.
/// Specified in SPEC-catalog.md §currency; owned by the `catalog` module.
///
/// It lands here in Task 4 rather than Task 6 because it is the root of the
/// foreign-key graph -- `user`, `portfolio` and `instrument` all point at it --
/// and because the integration harness needs one real, specified table to prove
/// itself against. Task 6 adds `exchange`, `data_source` and the seed.
model Currency {
  /// ISO 4217 code, e.g. BRL, USD.
  code String @id @db.Char(3)

  /// Display name, e.g. "Brazilian Real".
  name String @db.VarChar(64)

  /// Display symbol, e.g. R$. Not every currency has one in common use.
  symbol String? @db.VarChar(8)

  /// Decimal places the currency subdivides into -- normally 2, but 0 for JPY
  /// and 3 for KWD. Money is stored as an exact decimal regardless; this drives
  /// presentation, never arithmetic.
  minorUnit Int @map("minor_unit")

  /// Back-reference for the `exchange.currency_code` foreign key. Prisma
  /// requires the relation to be named on both models; this is a virtual field
  /// only -- it adds no column to `currency` and does not alter the Task 4
  /// migration, which stays exactly as applied.
  exchanges Exchange[]

  @@map("currency")
}

/// Trading venues. Reference data, seeded, not user-editable.
/// Specified in SPEC-catalog.md §exchange; owned by the `catalog` module.
model Exchange {
  /// Venue code, e.g. B3, NASDAQ.
  code String @id @db.VarChar(16)

  /// Display name, e.g. "B3 - Brasil, Bolsa, Balcao".
  name String @db.VarChar(128)

  /// ISO 3166-1 alpha-2 country the venue operates in.
  countryCode String @map("country_code") @db.Char(2)

  /// Trading currency. Foreign key to `currency.code`.
  currencyCode String @map("currency_code") @db.Char(3)

  /// IANA timezone name, e.g. America/Sao_Paulo. Defines the trading-day
  /// boundary.
  timezone String @db.VarChar(64)

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@map("exchange")
}

/// Provenance for every externally ingested fact.
/// Specified in SPEC-catalog.md §data_source; owned by the `catalog` module.
model DataSource {
  /// Surrogate key. Defaulted in the database so a plain SQL insert needs no id.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable machine name, e.g. B3_EOD, COINGECKO. Unique.
  name String @unique @db.VarChar(64)

  /// Free-text description of what the source provides.
  description String? @db.VarChar(255)

  /// Lower value wins when two sources disagree on the same fact.
  priority Int

  /// Whether the source is currently in use.
  isActive Boolean @map("is_active")

  @@map("data_source")
}
