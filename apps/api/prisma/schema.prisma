// ValueTracker database schema.
//
// Table and column names are snake_case, matching ARCHITECTURE.md and the
// SPEC-*.md entity dictionaries exactly; the Prisma models above them are
// PascalCase/camelCase, matching TypeScript. Every mapping is explicit, so a
// column can be read straight out of a spec and found in the database under the
// same name.
//
// Prisma 7 removed `url` from the datasource block entirely. The CLI reads its
// connection string from ../prisma.config.ts, and the running client is given a
// driver adapter built from the validated config in src/shared/config -- which
// is exactly the separation SPEC.md §Boundaries asks for: application code never
// reaches into process.env for a connection string.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// ISO 4217 reference data. Seeded, never user-editable.
/// Specified in SPEC-catalog.md §currency; owned by the `catalog` module.
///
/// It lands here in Task 4 rather than Task 6 because it is the root of the
/// foreign-key graph -- `user`, `portfolio` and `instrument` all point at it --
/// and because the integration harness needs one real, specified table to prove
/// itself against. Task 6 adds `exchange`, `data_source` and the seed.
model Currency {
  /// ISO 4217 code, e.g. BRL, USD.
  code String @id @db.Char(3)

  /// Display name, e.g. "Brazilian Real".
  name String @db.VarChar(64)

  /// Display symbol, e.g. R$. Not every currency has one in common use.
  symbol String? @db.VarChar(8)

  /// Decimal places the currency subdivides into -- normally 2, but 0 for JPY
  /// and 3 for KWD. Money is stored as an exact decimal regardless; this drives
  /// presentation, never arithmetic.
  minorUnit Int @map("minor_unit")

  /// Back-reference for the `exchange.currency_code` foreign key. Prisma
  /// requires the relation to be named on both models; this is a virtual field
  /// only -- it adds no column to `currency` and does not alter the Task 4
  /// migration, which stays exactly as applied.
  exchanges Exchange[]

  /// Back-reference for the `user.base_currency_code` foreign key (Task 8).
  /// Virtual only -- no column on `currency`, and the Task 4/6 migrations are
  /// untouched.
  users User[]

  /// Back-reference for the `portfolio.base_currency_code` foreign key
  /// (Task 11). Virtual only -- no column on `currency`.
  portfolios Portfolio[]

  /// Back-reference for the `instrument.currency_code` foreign key (Task 13).
  /// Virtual only -- no column on `currency`.
  instruments Instrument[]

  @@map("currency")
}

/// Trading venues. Reference data, seeded, not user-editable.
/// Specified in SPEC-catalog.md §exchange; owned by the `catalog` module.
model Exchange {
  /// Venue code, e.g. B3, NASDAQ.
  code String @id @db.VarChar(16)

  /// Display name, e.g. "B3 - Brasil, Bolsa, Balcao".
  name String @db.VarChar(128)

  /// ISO 3166-1 alpha-2 country the venue operates in.
  countryCode String @map("country_code") @db.Char(2)

  /// Trading currency. Foreign key to `currency.code`.
  currencyCode String @map("currency_code") @db.Char(3)

  /// IANA timezone name, e.g. America/Sao_Paulo. Defines the trading-day
  /// boundary.
  timezone String @db.VarChar(64)

  currency Currency @relation(fields: [currencyCode], references: [code])

  /// Back-reference for `instrument_equity.exchange_code` (Task 13). Virtual
  /// only -- no column on `exchange`.
  instrumentEquities InstrumentEquity[]

  /// Back-reference for `instrument_etf.exchange_code` (Task 13). Virtual
  /// only -- no column on `exchange`.
  instrumentEtfs InstrumentEtf[]

  @@map("exchange")
}

/// Provenance for every externally ingested fact.
/// Specified in SPEC-catalog.md §data_source; owned by the `catalog` module.
model DataSource {
  /// Surrogate key. Defaulted in the database so a plain SQL insert needs no id.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stable machine name, e.g. B3_EOD, COINGECKO. Unique.
  name String @unique @db.VarChar(64)

  /// Free-text description of what the source provides.
  description String? @db.VarChar(255)

  /// Lower value wins when two sources disagree on the same fact.
  priority Int

  /// Whether the source is currently in use.
  isActive Boolean @map("is_active")

  /// Back-reference for the `instrument.data_source_id` foreign key
  /// (Task 13). Virtual only -- no column on `data_source`.
  instruments Instrument[]

  @@map("data_source")
}

/// Transport a session's tokens travel over -- WEB (browser, cookie) or ANDROID
/// (native client, request body). It records transport, never privilege: there
/// is exactly one role in v1 (`SPEC-identity.md` §Objective).
enum ClientType {
  WEB
  ANDROID

  @@map("client_type")
}

/// A registered person. The root of every ownership chain -- `portfolio`,
/// `instrument` holdings and the ledger all scope to a `user.id`.
/// Specified in SPEC-identity.md §user; owned by the `identity` module.
///
/// The password hash is deliberately NOT on this model. It lives on
/// `UserCredential`, reachable only through an explicit `include`, so no plain
/// `prisma.user.findX` can return it and no user-facing read can leak it
/// (SPEC-identity.md §user_credential).
model User {
  /// Surrogate key. Defaulted in the database so a plain SQL insert needs no id.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Login identity. Uniqueness is a database constraint, not just an
  /// application check (SPEC-identity.md AC: "proven by a duplicate insert").
  email String @unique @db.VarChar(255)

  /// Shown in the UI; not an identifier.
  displayName String @map("display_name") @db.VarChar(128)

  /// Default currency for portfolios this user creates. Foreign key to
  /// `currency.code`; unknown codes are rejected by the database
  /// (SPEC-identity.md AC).
  baseCurrencyCode String @map("base_currency_code") @db.Char(3)

  /// IANA timezone name, e.g. America/Sao_Paulo.
  timezone String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  baseCurrency Currency        @relation(fields: [baseCurrencyCode], references: [code])
  credential   UserCredential?
  sessions     Session[]
  portfolios   Portfolio[]

  /// Back-reference for the `instrument.owner_user_id` foreign key
  /// (Task 13). Virtual only -- no column on `user`.
  instruments Instrument[]

  @@map("user")
}

/// One row per user who authenticates with a password. A provider-only (OIDC)
/// account simply has no row here, which is what keeps that future addition
/// migration-free (SPEC-identity.md §user_credential).
/// Owned by the `identity` module.
model UserCredential {
  /// Primary key AND foreign key to `user.id`: exactly one credential per user.
  userId String @id @map("user_id") @db.Uuid

  /// argon2id encoded hash, parameters included. Never returned by a `user`
  /// read; never logged.
  passwordHash String @map("password_hash") @db.VarChar(255)

  /// The algorithm that produced `password_hash`, recorded so a hash can be
  /// upgraded in place when the parameters change (SPEC-identity.md).
  algorithm String @db.VarChar(32)

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_credential")
}

/// A refresh-token store -- one row per logged-in device, NOT a cookie-session
/// table (ADR 0003). Holds only a SHA-256 hash of the opaque refresh token; the
/// token itself is never persisted. `replacedById` forms the rotation chain
/// that drives reuse detection.
/// Specified in SPEC-identity.md §session; owned by the `identity` module.
model Session {
  /// Internal identifier. Never sent to a client as a credential.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// SHA-256 hex of the refresh token (64 chars). Unique: a token maps to at
  /// most one live session (SPEC-identity.md AC).
  tokenHash String @unique @map("token_hash") @db.Char(64)

  /// Transport the session was opened over. See {@link ClientType}.
  clientType ClientType @map("client_type")

  /// Set to the successor session when this token is rotated; null while this
  /// is the current token. Self-foreign-key to `session.id`; presenting a
  /// token whose row has this set is reuse, and revokes the whole chain. The
  /// relation is `onDelete: Restrict` (Task 8 review carry-in): reuse detection
  /// reads this pointer, so a successor row must not be deletable while a
  /// predecessor still references it.
  replacedById String? @map("replaced_by_id") @db.Uuid

  issuedAt  DateTime  @default(now()) @map("issued_at")
  /// Absolute expiry (issue + 30 days). No sliding window.
  expiresAt DateTime  @map("expires_at")
  /// Null while the session is valid.
  revokedAt DateTime? @map("revoked_at")

  userAgent String? @map("user_agent") @db.VarChar(255)
  /// Client IP, IPv6-length.
  ip        String? @db.VarChar(45)

  user       User      @relation(fields: [userId], references: [id])
  replacedBy Session?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   Session[] @relation("SessionRotation")

  @@map("session")
}

/// A user's goal container -- "Faculdade da Ana", "Aposentadoria" -- and the
/// declaration of the currency its results are reported in.
/// Specified in SPEC-portfolio.md §portfolio; owned by the `portfolio` module.
///
/// Positions, holdings and transactions are NOT here: they belong to `ledger`,
/// because they are derived from transactions and maintained by the
/// cost-basis engine (SPEC-portfolio.md §Objective).
model Portfolio {
  /// Surrogate key. Defaulted in the database so a plain SQL insert needs no id.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Owner. Every read and write is scoped by this column in the `where`
  /// clause, never checked after fetching (SPEC.md §Code Style).
  userId String @map("user_id") @db.Uuid

  /// e.g. "Faculdade da Ana".
  name String @db.VarChar(128)

  description String? @db.VarChar(512)

  /// Free text, e.g. "buy a house in 10 years" -- never validated against a
  /// fixed list. An enum would force it into a GENERAL bucket that
  /// communicates nothing (SPEC-portfolio.md).
  objective String? @db.VarChar(255)

  /// Reporting currency. Immutable after creation -- changing it would
  /// invalidate every stored snapshot, since those record values already
  /// converted into this currency (SPEC-portfolio.md "Constraints that carry
  /// real weight"). Task 12's `PATCH` enforces the immutability; this FK just
  /// sets it at create time.
  baseCurrencyCode String @map("base_currency_code") @db.Char(3)

  /// Goal amount, denominated in `baseCurrencyCode`. Independently optional
  /// from `targetDate` -- a portfolio may carry either, both or neither.
  targetAmount Decimal? @map("target_amount") @db.Decimal(20, 4)

  /// Goal horizon. Independently optional from `targetAmount`.
  targetDate DateTime? @map("target_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  /// Null while active. Archive rather than delete: Task 12 adds the
  /// archive/unarchive endpoints, but the column exists from the start so
  /// every default query can already filter `archivedAt IS NULL`.
  archivedAt DateTime? @map("archived_at")

  user         User     @relation(fields: [userId], references: [id])
  baseCurrency Currency @relation(fields: [baseCurrencyCode], references: [code])

  /// A user cannot own two portfolios with the same name (SPEC-portfolio.md
  /// AC). Task 12 is the task that carries real weight for this constraint,
  /// but it is cheap and additive to add now rather than in a second
  /// migration later.
  @@unique([userId, name])
  @@map("portfolio")
}

// -----------------------------------------------------------------------------
// Instrument class-table hierarchy (Task 13; SPEC-catalog.md, ARCHITECTURE.md
// §7; the mechanism is settled by docs/adr/0005-instrument-inheritance.md,
// a GO decision from the Task 5 spike).
//
// One base `Instrument` row and exactly one specialization row
// (`InstrumentEquity` / `InstrumentEtf` / `InstrumentFixedIncome` /
// `InstrumentCrypto`), matching `instrumentType`. Prisma expresses the base
// table, the four specializations and their plain 1:1 foreign keys; it cannot
// express "exactly one, matching the discriminator" or a partial unique
// index. Those live as hand-authored SQL in this migration -- see
// `migrations/*_add_instrument_hierarchy/migration.sql` and the ADR for the
// exact DDL and why each piece cannot be expressed here.
//
// `instrument_type` (the discriminator lookup table) is deliberately NOT a
// Prisma model: it is pure hand-authored SQL (`CREATE TABLE` + seed
// `INSERT`s), so registering a fifth asset class is a data change, never a
// `prisma migrate dev` against this schema.
// -----------------------------------------------------------------------------

/// The security -- base of the class-table hierarchy. Exactly one
/// specialization row must exist for each row here, matching
/// `instrumentType`; enforced by a deferred constraint trigger
/// (`instrument_one_specialization`) and, for the "wrong type" half, by the
/// composite `(id, instrument_type)` foreign key each specialization
/// re-declares against `instrument_id_type_uk` below.
model Instrument {
  /// Surrogate key. Defaulted in the database so a plain SQL insert needs no id.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Discriminator: EQUITY, ETF, FIXED_INCOME, CRYPTO. FK to the
  /// hand-authored `instrument_type` lookup table (not a Prisma relation --
  /// see the header comment above).
  instrumentType String @map("instrument_type") @db.VarChar(24)

  /// Null = public catalog; non-null = private to that user.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  name String @db.VarChar(255)

  /// Denomination. Foreign key to `currency.code`.
  currencyCode String @map("currency_code") @db.Char(3)

  /// Null when the instrument is maintained by hand rather than ingested.
  dataSourceId String? @map("data_source_id") @db.Uuid

  /// ACTIVE, DELISTED, MATURED, SUSPENDED (Ruling S6 -- the 4-value set from
  /// the entity dictionary, not the 3-value diagram caption in SPEC-catalog.md).
  status String @db.VarChar(16)

  /// True for equity/ETF/crypto, false for fixed income. Derived, never
  /// trusted from a client: enforced by the hand-authored
  /// `instrument_is_variable_income_chk` CHECK, not merely validated in
  /// application code (SPEC-catalog.md AC).
  isVariableIncome Boolean @map("is_variable_income")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User?       @relation(fields: [ownerUserId], references: [id])
  currency   Currency    @relation(fields: [currencyCode], references: [code])
  dataSource DataSource? @relation(fields: [dataSourceId], references: [id])

  equity      InstrumentEquity?
  etf         InstrumentEtf?
  fixedIncome InstrumentFixedIncome?
  crypto      InstrumentCrypto?

  /// Target of the composite FK each specialization re-declares
  /// (`instrument_<type>_matches_base`, hand-authored): a specialization row
  /// cannot claim a type its base row does not have.
  @@unique([id, instrumentType], map: "instrument_id_type_uk")
  @@map("instrument")
}

/// The EQUITY specialization. `instrumentType` and `ownerUserId` are
/// denormalised onto this table, not user-settable: a hand-authored CHECK
/// pins `instrumentType` to 'EQUITY', and a hand-authored `BEFORE
/// INSERT/UPDATE` trigger copies `ownerUserId` from the base row -- which is
/// what the partial unique index on (`exchange_code`, `ticker`) needs, since
/// its predicate column lives here but its source of truth lives on
/// `instrument`.
model InstrumentEquity {
  /// Shared primary key: also the foreign key to `instrument.id`.
  instrumentId String @id @map("instrument_id") @db.Uuid

  /// Pinned to 'EQUITY' by a hand-authored CHECK; see the migration.
  instrumentType String @default("EQUITY") @map("instrument_type") @db.VarChar(24)

  /// Trigger-maintained copy of `instrument.owner_user_id`; see the model doc.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  ticker       String  @db.VarChar(16)
  exchangeCode String  @map("exchange_code") @db.VarChar(16)
  isin         String? @db.Char(12)
  sector       String? @db.VarChar(64)
  countryCode  String? @map("country_code") @db.Char(2)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  exchange   Exchange   @relation(fields: [exchangeCode], references: [code])

  /// Public natural key `(exchange_code, ticker)`, unique only among public
  /// rows (`owner_user_id IS NULL`) -- a hand-authored partial unique index,
  /// since Prisma cannot express one; see the migration.
  @@map("instrument_equity")
}

/// The ETF specialization. Kept separate from `InstrumentEquity` because an
/// ETF's economics are described by its benchmark and expense ratio, not a
/// sector and issuer domicile (SPEC-catalog.md). Same denormalisation
/// pattern as {@link InstrumentEquity}: see its doc comment.
model InstrumentEtf {
  instrumentId   String  @id @map("instrument_id") @db.Uuid
  instrumentType String  @default("ETF") @map("instrument_type") @db.VarChar(24)
  ownerUserId    String? @map("owner_user_id") @db.Uuid

  ticker       String  @db.VarChar(16)
  exchangeCode String  @map("exchange_code") @db.VarChar(16)
  isin         String? @db.Char(12)
  benchmarkIndex String? @map("benchmark_index") @db.VarChar(64)
  /// Annual, as a fraction.
  expenseRatio Decimal? @map("expense_ratio") @db.Decimal(6, 4)
  /// PHYSICAL, SYNTHETIC.
  replicationMethod String? @map("replication_method") @db.VarChar(16)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  exchange   Exchange   @relation(fields: [exchangeCode], references: [code])

  /// Public natural key `(exchange_code, ticker)` -- its own partial unique
  /// index, not shared with `instrument_equity`'s. Hand-authored; see the
  /// migration.
  @@map("instrument_etf")
}

/// The FIXED_INCOME specialization -- bonds, CDBs, treasury notes. No public
/// natural-key uniqueness: fixed income has no natural public key in this
/// spec (SPEC-catalog.md), so this table carries no partial unique index.
model InstrumentFixedIncome {
  instrumentId   String  @id @map("instrument_id") @db.Uuid
  instrumentType String  @default("FIXED_INCOME") @map("instrument_type") @db.VarChar(24)
  ownerUserId    String? @map("owner_user_id") @db.Uuid

  /// Bank or government.
  issuerName String @map("issuer_name") @db.VarChar(255)
  /// CNPJ or equivalent.
  issuerTaxId String? @map("issuer_tax_id") @db.VarChar(32)
  /// PRE, CDI, IPCA, SELIC.
  indexationType String @map("indexation_type") @db.VarChar(16)
  /// Annual rate -- the fixed part, or the spread over an index.
  contractedRate Decimal? @map("contracted_rate") @db.Decimal(10, 6)
  /// e.g. 110 for 110% of CDI.
  indexPercentage Decimal? @map("index_percentage") @db.Decimal(10, 4)
  issueDate    DateTime @map("issue_date") @db.Date
  maturityDate DateTime @map("maturity_date") @db.Date
  /// NONE, MONTHLY, SEMIANNUAL, ANNUAL.
  couponFrequency String @map("coupon_frequency") @db.VarChar(16)
  /// e.g. BUS252, ACT360.
  dayCountConvention String @map("day_count_convention") @db.VarChar(16)
  /// Nominal at maturity.
  faceValue Decimal? @map("face_value") @db.Decimal(20, 6)
  /// Daily liquidity or not.
  allowsEarlyRedemption Boolean @map("allows_early_redemption")
  /// e.g. REGRESSIVE_IR, EXEMPT.
  taxRegime String? @map("tax_regime") @db.VarChar(24)

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@map("instrument_fixed_income")
}

/// The CRYPTO specialization. Same denormalisation pattern as
/// {@link InstrumentEquity}: see its doc comment.
model InstrumentCrypto {
  instrumentId   String  @id @map("instrument_id") @db.Uuid
  instrumentType String  @default("CRYPTO") @map("instrument_type") @db.VarChar(24)
  ownerUserId    String? @map("owner_user_id") @db.Uuid

  symbol          String  @db.VarChar(16)
  /// e.g. BITCOIN, ETHEREUM.
  network         String? @db.VarChar(32)
  /// For tokens.
  contractAddress String? @map("contract_address") @db.VarChar(128)
  /// Divisibility, e.g. 8 for BTC.
  decimals        Int

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  /// Public natural key `(symbol, network)`, unique only among public rows.
  /// Hand-authored partial unique index; see the migration.
  @@map("instrument_crypto")
}
