{
  // The shipped build: production sources only. Tests are typechecked by the
  // base config (`npm run typecheck`) but never emitted into dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.int-spec.ts",
    "dist",
    "node_modules"
  ]
}
