# Copy to .env, or generate it with: ./scripts/check-env.sh --init-env
#
# Compose interpolates these; they are host-specific, which is why .env is not
# committed. HOST_UID/HOST_GID keep bind-mounted files owned by you instead of
# root; DOCKER_GID lets the container read the mounted docker socket.
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999
