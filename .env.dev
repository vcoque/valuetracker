# ValueTracker -- DEVELOPMENT configuration. Committed on purpose.
#
# Loaded explicitly, never implicitly:
#   docker compose -f compose-dev.yaml \
#     --env-file .env.dev --env-file .env.dev.local <command>
# (./scripts/dev.sh and ./scripts/check-env.sh pass both for you.)
#
# Nothing here is a secret. Every value addresses a container on the developer's
# own machine, and the database it describes is reachable only from the local
# Compose network. A deployed environment gets its own file and takes its
# credentials from the platform -- never from this repository.
#
# Per-machine values (uid, gid, docker group) are NOT here. They belong in
# .env.dev.local, which is gitignored; see .env.dev.local.example.

COMPOSE_PROJECT_NAME=valuetracker-dev
NODE_ENV=development

# --- Toolchain image ---------------------------------------------------------
# Keep in step with .nvmrc. Pinned to a patch version: a floating tag would make
# two developers' toolchains differ without either of them changing anything.
NODE_IMAGE=node:24.20.0-bookworm-slim

# --- Development database ----------------------------------------------------
# SPEC.md requires PostgreSQL 16+. Integration tests do not use this instance;
# Testcontainers gives each run its own.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=valuetracker
POSTGRES_PASSWORD=valuetracker
POSTGRES_DB=valuetracker

# --- Ports published to the host ---------------------------------------------
# Only these two are host-facing; in-network ports stay at their defaults.
# Change them if something already occupies the port on your machine.
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5432

# --- Testcontainers ----------------------------------------------------------
# The test suite runs inside a container and starts its databases as siblings
# via the shared docker socket. Those siblings publish their ports on the host,
# so the client must dial the host gateway rather than localhost.
# compose-dev.yaml maps host.docker.internal to it via extra_hosts.
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
