{
  "name": "@valuetracker/contract",
  "version": "0.0.0",
  "private": true,
  "description": "Wire contracts for ValueTracker: zod request/response schemas and their inferred types. Validated by the API, inferred by every client. Imports nothing from apps/*.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepare": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
