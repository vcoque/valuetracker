# ValueTracker -- CONTINUOUS INTEGRATION configuration. Committed on purpose.
#
# Loaded explicitly, never implicitly, by the GitHub Actions workflow:
#   docker compose -f compose-ci.yaml --env-file .env.ci <command>
# (.github/workflows/ci.yml passes it for you.)
#
# Nothing here is a secret -- same rule as .env.dev. There is no CI
# counterpart to .env.dev.local: a GitHub Actions runner is a fresh machine
# every run, so there is no per-machine file worth keeping. The three values
# that vary per machine in dev (HOST_UID, HOST_GID, DOCKER_GID) are computed
# by the workflow itself, the same way `check-env.sh --init-env` computes them
# locally, and exported as plain shell environment variables instead.

COMPOSE_PROJECT_NAME=valuetracker-ci
NODE_ENV=test

# --- Toolchain image ---------------------------------------------------------
# Same pin as .env.dev. CI and a developer's machine must run the identical
# toolchain, or "passes locally" and "passes in CI" stop meaning the same
# thing. Keep in step with .nvmrc and .env.dev's NODE_IMAGE together.
NODE_IMAGE=node:24.20.0-bookworm-slim

# --- Testcontainers -----------------------------------------------------------
# Integration and e2e tests provision their own throwaway PostgreSQL via
# Testcontainers (apps/api/test/global-setup.ts). There is no persistent `db`
# service here the way compose-dev.yaml has one for the local dev loop -- CI
# never runs start:dev or `prisma migrate dev`, so nothing needs it. Same
# image pin as .env.dev, so a constraint that holds in CI and not in dev (or
# the reverse) cannot happen.
POSTGRES_IMAGE=postgres:17-alpine

# The suite runs inside this container and shares the runner's own docker
# socket (compose-ci.yaml), so the databases Testcontainers starts are
# *siblings* of this container, not children. They publish their ports on the
# runner host, so the client must dial back out through the gateway --
# identical to why compose-dev.yaml sets this for the local toolchain
# container.
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
