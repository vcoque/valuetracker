# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# environment
# Environment files are named for the environment they configure. Shared,
# non-secret configuration (.env.dev) is committed so a clone is runnable;
# only per-machine and secret-bearing overrides are ignored.
.env
.env.*.local
!.env.*.local.example

# test / coverage
coverage/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
